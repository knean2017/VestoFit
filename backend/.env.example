# Copy this file to backend/.env and fill in the values

# --- Database ---
DATABASE_URL=postgresql+asyncpg://fitme:fitme@db:5432/fitme

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./.storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/files

# Only required when STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fitme-assets
R2_PUBLIC_URL=

# --- AI ---
# Get a key from https://fal.ai/dashboard/keys
FAL_KEY=

# Try-on model. Options (best -> alternatives):
#   fal-ai/kling/v1-5/kolors-virtual-try-on   (DEFAULT, best identity preservation ~$0.07)
#   fal-ai/fashn/tryon/v1.6                   (best for complex fabrics ~$0.075)
#   fal-ai/cat-vton                           (good for non-standard poses, runs in quality mode)
#   fal-ai/image-apps-v2/virtual-try-on       (cheaper ~$0.04, 4K output)
#   fal-ai/idm-vton                           (legacy)
#   fal-ai/leffa                              (fast)
FAL_TRYON_MODEL=fal-ai/kling/v1-5/kolors-virtual-try-on

# Avatar editor — Flux Kontext edits the user's actual photo, preserving body.
#   fal-ai/flux-pro/kontext       (DEFAULT, balanced quality/cost ~$0.04)
#   fal-ai/flux-pro/kontext/max   (max quality ~$0.08)
#   fal-ai/flux-kontext/dev       (open weights, cheaper)
FAL_AVATAR_MODEL=fal-ai/flux-pro/kontext

# --- App ---
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000

# --- LLM (wardrobe tagging + stylist) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
# OPENAI_API_KEY=
